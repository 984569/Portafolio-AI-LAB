# Copy to .env only if you want to configure the optional Agent Desk provider.
# Keep the real key in .env and load it only in the backend process.
APP_TRADING_MODE=PAPER
ENABLE_LIVE_TRADING=false
ENABLE_TEST_FIXTURES=false
PORTFOLIO_DB_PATH=.runtime/portfolio.sqlite3
MARKET_DATA_ROOT=.runtime/datasets
TRAINING_ROOT=.runtime/training
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
OPENROUTER_PROVIDER=nvidia/nvfp4
